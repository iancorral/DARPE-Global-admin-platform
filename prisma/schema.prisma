// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// What a staff account may manage. Everyone sees everything; the role only
/// decides who can add people and reset their passwords (OWNER and ADMIN).
///
/// OWNER is Dhanna; ADMIN is whoever maintains the app; STAFF is everyone else
/// who runs the academy day to day.
enum UserRole {
  OWNER
  ADMIN
  STAFF
}

model Profile {
  id        String   @id @db.Uuid
  email     String   @unique
  name      String
  role      UserRole @default(ADMIN)
  /// When this person last set their own password, through the app.
  ///
  /// Null means they are still on the password the account was created with,
  /// which somebody else chose and therefore knows. That is the only question
  /// this field answers, and it is why it is a date rather than a flag: "has
  /// never set one" and "set one in August" are both worth being able to see.
  ///
  /// Supabase Auth owns the password itself; this records only that the change
  /// went through the app, because `auth.users` is not Prisma's to read.
  passwordSetAt DateTime?
  /// Notes this person wrote. A note is private unless it was shared with the
  /// team: a private one is only ever reachable by its owner.
  notes     Note[] @relation("NoteOwner")
  /// Shared tasks pointed at this person.
  assignedNotes Note[] @relation("NoteAssignee")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("profiles")
}

/// Workspace configuration the academy can change for itself.
///
/// A single row, always `id = "academy"`. Settings are one small set of values
/// with no natural key of their own, and a fixed id makes reading them a
/// primary-key lookup rather than "the first row, hopefully". The application
/// falls back to sensible defaults when the row does not exist yet, so nothing
/// depends on it having been created.
model AcademySettings {
  id String @id @default("academy")

  /// First hour of the normal teaching day, 0-23.
  dayStartHour Int @default(8)
  /// First hour that is no longer the teaching day, 1-24.
  dayEndHour   Int @default(20)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("academy_settings")
}

/// The list price of one course, as staff have set it.
///
/// One row per modality, and only for the modalities somebody has edited: the
/// application starts from the published table in
/// `src/features/finance/pricing.ts` and a row here overrides it. Prices are
/// reviewed yearly and students keep the rate they started at, so this is a
/// list price and never an amount a particular student owes.
model CoursePrice {
  modality  Modality @id
  mxnCents  Int
  usdCents  Int
  updatedAt DateTime @updatedAt

  @@map("course_prices")
}

/// Where a student is in their relationship with DARPE.
///
/// There is no trial state: DARPE does not give trial classes. Somebody who
/// wants to try one books an advisory, which is an ordinary paid class.
enum StudentStatus {
  ACTIVE
  PAUSED
  ARCHIVED
}

/// How a student's place is being paid for, in DARPE's own words.
///
/// This is deliberately separate from `StudentStatus`: an active student is
/// *also* paid, pending, or one of the arrangements below, and the two answer
/// different questions. Collapsing them into one field would make "a student on
/// benefit who has paused" impossible to record, and would leave nothing to
/// drive the archive-after-a-month rule.
///
/// BENEFIT and COLLABORATION are not payment states at all — they are why no
/// money is expected. Staff still see one chip per student, because the list
/// shows the lifecycle when it is not ACTIVE and this when it is.
enum BillingStatus {
  /// Paid for the current course.
  PAID
  /// Owes the current course.
  PENDING
  /// Place held, not yet paid.
  RESERVED
  /// A DARPE teacher taking classes with another DARPE teacher.
  BENEFIT
  /// Classes in exchange for work, such as videos about the academy.
  COLLABORATION
}

enum Modality {
  ADVISORY
  GROUP_EXTENSIVE
  INDIVIDUAL_EXTENSIVE
  INDIVIDUAL_INTENSIVE
}

enum ClassType {
  INDIVIDUAL
  GROUP
}

enum ClassStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum Attendance {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

model Language {
  id        String   @id @default(cuid())
  name      String   @unique
  code      String   @unique @db.VarChar(5)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  teachers TeacherLanguage[]
  students Student[]
  sessions ClassSession[]
  groups   Group[]

  @@map("languages")
}

model Teacher {
  id              String   @id @default(cuid())
  firstName       String
  /// Optional: DARPE's own register holds many people by first name alone.
  /// Read it through `fullName()`, never by interpolation.
  lastName        String?
  email           String?  @unique
  phone           String?
  hourlyRateCents Int?
  notes           String?
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  languages       TeacherLanguage[]
  primaryStudents Student[]
  sessions        ClassSession[]
  scheduleSlots   ScheduleSlot[]
  groups          Group[]
  payouts         TeacherPayout[]

  @@index([active])
  @@map("teachers")
}

model TeacherLanguage {
  teacherId  String
  languageId String

  teacher  Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  language Language @relation(fields: [languageId], references: [id], onDelete: Restrict)

  @@id([teacherId, languageId])
  @@map("teacher_languages")
}

model Student {
  id               String        @id @default(cuid())
  firstName        String
  /// Optional — see the note on `Teacher.lastName`.
  lastName         String?
  email            String?
  phone            String?
  /// CEFR level, "A1" through "C2". Stored as text rather than an enum because
  /// DARPE has not finished deciding how it grades: changing a list in Zod is
  /// cheap, changing a Postgres enum is a migration.
  level            String?
  goal             String?
  modality         Modality
  status           StudentStatus @default(ACTIVE)
  billing          BillingStatus @default(PENDING)
  /// How this student usually pays. A fact about the person, not about one
  /// payment — staff want to see at a glance who is on transfer and who is on
  /// Stripe, without opening a payment record. Null until somebody says.
  payMethod        PaymentMethod?
  /// When the student was last paused. Null whenever they are not paused.
  ///
  /// Recorded so that "paused for over a month" is a fact rather than a guess;
  /// nothing else can answer it, because a status field remembers no dates.
  pausedAt         DateTime?
  startedAt        DateTime?
  languageId       String
  primaryTeacherId String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  language       Language           @relation(fields: [languageId], references: [id], onDelete: Restrict)
  primaryTeacher Teacher?           @relation(fields: [primaryTeacherId], references: [id], onDelete: SetNull)
  participations ClassParticipant[]
  scheduleSlots  ScheduleSlot[]
  groupMemberships GroupMember[]
  payments       Payment[]

  @@index([status])
  @@index([primaryTeacherId])
  @@map("students")
}

model ClassSession {
  id              String      @id @default(cuid())
  startsAt        DateTime
  durationMinutes Int
  type            ClassType
  status          ClassStatus @default(SCHEDULED)
  topic           String?
  notes           String?
  teacherId       String
  languageId      String
  groupId         String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  scheduleSlotId  String?
  // The slot occurrence this session was generated for. Never changes when the
  // session is rescheduled, so regeneration still recognises it as existing.
  slotOccurrenceOn DateTime? @db.Date

  teacher      Teacher            @relation(fields: [teacherId], references: [id], onDelete: Restrict)
  language     Language           @relation(fields: [languageId], references: [id], onDelete: Restrict)
  participants ClassParticipant[]
  scheduleSlot ScheduleSlot?      @relation(fields: [scheduleSlotId], references: [id], onDelete: SetNull)
  group        Group?             @relation(fields: [groupId], references: [id], onDelete: SetNull)

  @@unique([scheduleSlotId, slotOccurrenceOn])
  @@index([startsAt])
  @@index([teacherId, startsAt])
  @@map("class_sessions")
}

model ClassParticipant {
  id             String      @id @default(cuid())
  classSessionId String
  studentId      String
  attendance     Attendance?
  notes          String?

  classSession ClassSession @relation(fields: [classSessionId], references: [id], onDelete: Cascade)
  student      Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([classSessionId, studentId])
  @@map("class_participants")
}

model ScheduleSlot {
  id              String   @id @default(cuid())
  /// Set for an individual pattern. Exactly one of `studentId` and `groupId`
  /// is ever set — enforced by a check constraint, since Prisma cannot say it.
  studentId       String?
  /// Set for a group pattern.
  groupId         String?
  teacherId       String
  weekday         Int // 0 = Sunday ... 6 = Saturday
  startTime       String    @db.VarChar(5) // "13:00"
  durationMinutes Int
  startsOn        DateTime  @db.Date
  endsOn          DateTime? @db.Date
  active          Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  sessions ClassSession[]

  student Student? @relation(fields: [studentId], references: [id], onDelete: Cascade)
  group   Group?   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  teacher Teacher  @relation(fields: [teacherId], references: [id], onDelete: Restrict)

  @@index([studentId])
  @@index([groupId])
  @@index([teacherId])
  @@map("schedule_slots")
}

/// A cohort taught together: one teacher, one language, several students.
///
/// Group classes were always possible as records — `ClassSession` has held many
/// participants from the start — but there was nothing to say *which* students
/// belong together week after week. That is what this adds, and it is what a
/// recurring group schedule needs to expand into classes.
model Group {
  id         String   @id @default(cuid())
  name       String   @unique
  teacherId  String
  languageId String
  /// An inactive group keeps its history and stops producing new classes,
  /// exactly like an inactive teacher.
  active     Boolean  @default(true)
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  teacher       Teacher        @relation(fields: [teacherId], references: [id], onDelete: Restrict)
  language      Language       @relation(fields: [languageId], references: [id], onDelete: Restrict)
  members       GroupMember[]
  scheduleSlots ScheduleSlot[]
  sessions      ClassSession[]

  @@index([teacherId])
  @@index([languageId])
  @@index([active])
  @@map("groups")
}

/// A student's place in a group.
///
/// `joinedAt` is recorded now so that "who was in the group when" can be
/// answered later without a second migration; leaving is not modelled yet.
model GroupMember {
  groupId   String
  studentId String
  joinedAt  DateTime @default(now())

  group   Group   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@id([groupId, studentId])
  @@index([studentId])
  @@map("group_members")
}

/// How money moved. DARPE takes cash, Stripe and bank transfers.
enum PaymentMethod {
  CASH
  STRIPE
  TRANSFER
}

/// The currencies DARPE charges in. Students outside Latin America pay in USD.
enum Currency {
  MXN
  USD
}

/// Money actually received from a student.
///
/// Revenue is recognised on `receivedOn` — DARPE counts income when the money
/// arrives, not when it was agreed or invoiced. That is the whole basis of the
/// finance figures, so there is no invoice model behind this: a payment is a
/// record of something that happened, not of something expected.
model Payment {
  id          String        @id @default(cuid())
  studentId   String
  amountCents Int
  currency    Currency      @default(MXN)
  method      PaymentMethod
  /// The day the money arrived. Revenue counts on this date.
  receivedOn  DateTime      @db.Date
  notes       String?
  /// Set only when the student paid in another currency. `amountCents` is
  /// always what it came to in pesos — the figure every total uses — and these
  /// three record what was actually handed over, for reference.
  originalCurrency    String? @db.VarChar(3)
  originalAmountCents Int?
  /// Pesos per one unit of `originalCurrency`, times 1,000,000 (17.07 → 17070000).
  exchangeRateMicros  Int?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Restrict)

  @@index([receivedOn])
  @@index([studentId])
  @@map("payments")
}

/// Whether a teacher has been paid for a period.
///
/// Deliberately a reminder rather than a calculation. DARPE already knows what
/// each teacher earns; what the staff lack is a record of who has been paid and
/// who is still owed. The hours behind a period are derived from completed
/// classes rather than stored, so they can never disagree with the calendar.
model TeacherPayout {
  id          String         @id @default(cuid())
  teacherId   String
  /// Inclusive first and last day of the period being settled.
  periodStart DateTime       @db.Date
  periodEnd   DateTime       @db.Date
  amountCents Int
  currency    Currency       @default(MXN)
  /// Null until it has been paid. This flag is the point of the record.
  paidOn      DateTime?      @db.Date
  method      PaymentMethod?
  notes       String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Restrict)

  /// One settlement per teacher per period; re-settling edits it rather than
  /// quietly creating a second one.
  @@unique([teacherId, periodStart, periodEnd])
  @@index([paidOn])
  @@map("teacher_payouts")
}

/// A private note: free text, a checklist, or both.
///
/// Owned by one profile and visible to nobody else in the app. `archived` is
/// "done" — out of the way, never deleted by accident.
model Note {
  id        String    @id @default(cuid())
  ownerId   String    @db.Uuid
  title     String    @default("")
  body      String    @default("")
  /// A tone name from `NOTE_COLORS`, or null for plain white.
  color     String?
  /// "URGENT" or "IMPORTANT" from `NOTE_PRIORITIES`, null for an ordinary note.
  /// Text rather than an enum: it mirrors the "Importancia" column of DARPE's
  /// own tracking sheet, and that vocabulary is still theirs to change.
  priority  String?
  /// False for a private note, true for one on the team board every staff
  /// member reads and edits. DARPE's own tracking sheet is a shared list with a
  /// "Responsable" column, and a private notebook could not replace it.
  shared     Boolean  @default(false)
  /// Who a shared task is for. Null means nobody has taken it yet. Only
  /// meaningful while `shared` is true.
  assigneeId String?  @db.Uuid
  pinned    Boolean   @default(false)
  /// A day to be reminded on; the dashboard shows it from that day on.
  dueOn     DateTime? @db.Date
  archived  Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  owner    Profile    @relation("NoteOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  assignee Profile?   @relation("NoteAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  items    NoteItem[]

  @@index([ownerId, archived])
  @@index([shared, archived])
  @@map("notes")
}

/// One line of a note's checklist.
model NoteItem {
  id        String   @id @default(cuid())
  noteId    String
  text      String
  done      Boolean  @default(false)
  position  Int
  createdAt DateTime @default(now())

  note Note @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@index([noteId])
  @@map("note_items")
}
