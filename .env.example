# Copy to .env and fill in. Never commit .env or .env.local.

# --- Database (Prisma / Supabase Postgres) ---
# Pooled connection used by the application.
DATABASE_URL=
# Direct connection used by migrations.
DIRECT_URL=

# --- Supabase Auth ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Development only ---
# Extra hosts allowed to load /_next/* resources from `next dev`.
#
# Only needed to open the dev server from another device on the LAN, such as a
# phone. Without it those requests are refused and the page loads but never
# hydrates: it renders, links still work, and nothing that needs JavaScript does.
#
# Exact hosts only, comma separated. No protocol, no port, no path, no wildcard —
# Next matches the request's hostname alone, and a wildcard such as 192.168.*.*
# would admit every device on the network rather than the one you are testing.
# Invalid entries are ignored with a warning rather than widened.
#
# Ignored entirely by `next build` and `next start`.
#
# One device:
#   DEV_ALLOWED_ORIGINS=192.168.1.69
# Several:
#   DEV_ALLOWED_ORIGINS=192.168.1.69,192.168.1.70,my-laptop.local
DEV_ALLOWED_ORIGINS=