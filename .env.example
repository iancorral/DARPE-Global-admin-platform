# Copy to .env and fill in. Never commit .env or .env.local.

# --- Database (Prisma / Supabase Postgres) ---
# Pooled connection used by the application.
DATABASE_URL=
# Direct connection used by migrations.
DIRECT_URL=

# --- Supabase Auth ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Demo records for development ---
# Read only by `pnpm db:seed`, never by the application.
#
# With this set to "true" the seed also creates 5 invented teachers, 8 invented
# students and their weekly schedule slots, so the calendar, dashboard and lists
# can be judged with something in them. Every address is on
# @demo.darpe.invalid, which is how you find and delete them again.
#
# After seeding, open the calendar and press "Generate month" to turn the slots
# into real classes through the normal generation logic.
#
# Leave unset for a database that should only contain real records.
DARPE_SEED_DEMO=false

# --- Dashboard finance preview (sample data) ---
# Set to "true" to fill the dashboard's finance section with SAMPLE figures so
# its layout, colours and interaction can be reviewed. Everything it shows is
# invented: no revenue, outstanding amount or payment status in that section is
# real, and a "Sample data" badge is displayed whenever it is on.
#
# It reads nothing from and writes nothing to the database. Leave it unset (or
# "false") and the section shows an honest "not configured yet" state instead.
# Do not enable it where anyone might read the numbers as DARPE's actual money.
DARPE_DEMO_FINANCE=false

# --- Development only ---
# Extra hosts allowed to load /_next/* resources from `next dev`.
#
# Only needed to open the dev server from another device on the LAN, such as a
# phone. Without it those requests are refused and the page loads but never
# hydrates: it renders, links still work, and nothing that needs JavaScript does.
#
# Exact hosts only, comma separated. No protocol, no port, no path, no wildcard —
# Next matches the request's hostname alone, and a wildcard such as 192.168.*.*
# would admit every device on the network rather than the one you are testing.
# Invalid entries are ignored with a warning rather than widened.
#
# Ignored entirely by `next build` and `next start`.
#
# One device:
#   DEV_ALLOWED_ORIGINS=192.168.1.69
# Several:
#   DEV_ALLOWED_ORIGINS=192.168.1.69,192.168.1.70,my-laptop.local
DEV_ALLOWED_ORIGINS=